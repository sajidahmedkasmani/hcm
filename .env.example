# Copy to .env for local runs. On a hosting provider, set these in its environment settings.
# Never commit the real .env (AI key, DB password, JWT secret).

# --- Database -----------------------------------------------------------------------
# SQLite for local use. In production use a hosted PostgreSQL (Neon, Supabase, Render, Railway):
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./hcm_lite.db

# --- Auth -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_MINUTES=480
BCRYPT_ROUNDS=12
APP_TIMEZONE=Asia/Karachi
# Sign-in throttling: failures allowed per email and per client IP within the window
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
# Apply Alembic migrations on startup. Set false if you run `alembic upgrade head` as a pre-deploy step.
AUTO_MIGRATE=true

# --- Camera attendance ----------------------------------------------------------------
# Max distance between a camera frame and the enrolled face (dlib 128-d descriptors). 0.5 is a little stricter
# than dlib's usual 0.6. Lower = fewer false accepts, more "doesn't match" retries.
FACE_MATCH_THRESHOLD=0.5

# --- Optional first run from env (otherwise the browser opens the setup screen) ---------
ADMIN_EMAIL=
ADMIN_PASSWORD=
COMPANY_NAME=

# --- AI assistant (M8) ----------------------------------------------------------------
# Any OpenAI-compatible API with tool calling. Leave AI_API_KEY empty to use the built-in
# offline engine (rule-based, same tools and permissions).
AI_API_KEY=
# Groq (free tier):
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# Google Gemini (free tier) instead:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=15
AI_RATE_LIMIT_PER_HOUR=20
AI_OFFLINE_FALLBACK=true

# Comma-separated origins if the frontend is hosted elsewhere (the app also serves its own UI at /)
CORS_ORIGINS=*
